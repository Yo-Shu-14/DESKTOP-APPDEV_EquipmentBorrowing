<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    x:Class="EquipmentBorrowing.Desktop.MainWindow"
    x:DataType="viewmodels:MainWindowViewModel"
    Width="900"
    Height="600"
    Title="Equipment Borrowing System">


    <Grid ColumnDefinitions = "200,*">
    
    <StackPanel Grid.Column="0" Margin="20" Spacing="15">
    <TextBlock Classes="sidebarTitle" Text="EB SYSTEM"/>
    <Button Content="Equipment" Command="{Binding ShowEquipmentCommand}"/>
    <Button Content="Active Borrowings" Command="{Binding ShowActiveBorrowingsCommand}"/>


   </StackPanel>


        <Border
            Grid.Column="1"
            Margin="10">

            <ContentControl
                Content="{Binding CurrentView}"/>

        </Border>

    </Grid>

</Window>