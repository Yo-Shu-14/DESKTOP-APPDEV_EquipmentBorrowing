<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    x:Class="EquipmentBorrowing.Desktop.MainWindow"
    x:DataType="viewmodels:MainWindowViewModel"
    Width="900"
    Height="600"
    Title="Equipment Borrowing System">


    <Grid ColumnDefinitions = "200,*">
    
    <StackPanel Grid.Column="0" Margin="20" Spacing="15">
    <TextBlock Classes="sidebarTitle" Text="EB SYSTEM"/>
    <Button Content="Equipment" Command="{Binding ShowEquipmentCommand}"/>
    <Button Content="Active Borrowings" Command="{Binding ShowActiveBorrowingsCommand}"/>
    <Button
        Content="Student History"
        Command="{Binding ShowStudentHistoryCommand}"/>

    <Button
        Content="Equipment History"
        Command="{Binding ShowEquipmentHistoryCommand}"/>

    <Button
        Content="Search Borrowings"
        Command="{Binding ShowSearchBorrowingsCommand}"/>

    <Button
        Content="Register Student"
        Command="{Binding ShowRegisterStudentCommand}"/>

    <Button
        Content="Update Student Information"
        Command="{Binding ShowUpdateStudentInformationCommand}"/>

    <Button
        Content="Change Student Eligibility"
        Command="{Binding ShowChangeStudentEligibilityCommand}"/>
    <Button
        Content="Register Equipment"
        Command="{Binding ShowRegisterEquipmentCommand}"/>


   </StackPanel>


        <Border
            Grid.Column="1"
            Margin="10">

            <ContentControl
                Content="{Binding CurrentView}"/>

        </Border>

    </Grid>

</Window>