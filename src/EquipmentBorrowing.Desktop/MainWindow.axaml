<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EquipmentBorrowing.Desktop.Views"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    x:Class="EquipmentBorrowing.Desktop.MainWindow"
    x:DataType="viewmodels:EquipmentViewModel"
    Width="900"
    Height="600"
    Title="Equipment Borrowing System">

    <Grid ColumnDefinitions = "200,*">
    
    <StackPanel Grid.Column="0" Margin="20" Spacing="15">
    <TextBlock Text="Equipment" FontSize="20" FontWeight="Bold"/>
    <Button Content="Equipment" Click="Equipmentbutton_Click"/>
    <Button Content="Active Borrowings" Click="ActiveBorrowingsbutton_Click"/>
    </StackPanel>

    <Border Grid.Column="1" Margin="10">
        <ContentControl x:Name="ContentArea">
    <views:EquipmentView  DataContext="{Binding}"/>
        </ContentControl>
    

    
    </Border>
    
    </Grid>


</Window>