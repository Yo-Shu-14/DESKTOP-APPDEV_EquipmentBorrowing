<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    x:Class="EquipmentBorrowing.Desktop.MainWindow"
    x:DataType="viewmodels:MainWindowViewModel"
    Width="1100"
    Height="700"
    WindowState="Maximized"
    Title="Campus Equipment Borrowing System">

    <Grid ColumnDefinitions="260,*">

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="#F4F6F8"
                BorderBrush="#E5E8EB"
                BorderThickness="0,0,1,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,20" Spacing="2">

                    <!-- System Brand -->
                    <TextBlock Classes="sidebarTitle" Text="EQUIPMENT SYSTEM"/>
                    <TextBlock Text="Custodian Management"
                               FontSize="12"
                               Foreground="#6c757d"
                               Margin="0,0,0,14"/>

                    <!-- Category: Catalog & Loans -->
                    <TextBlock Classes="sidebarCategory" Text="CATALOG &amp; BORROWING"/>
                    <Button Classes="navBtn" Content="Equipment Catalog" Command="{Binding ShowEquipmentCommand}"/>
                    <Button Classes="navBtn" Content="Active Borrowings" Command="{Binding ShowActiveBorrowingsCommand}"/>

                    <!-- Category: Records & Search -->
                    <TextBlock Classes="sidebarCategory" Text="HISTORIES &amp; SEARCH"/>
                    <Button Classes="navBtn" Content="Search &amp; Filter Borrowings" Command="{Binding ShowSearchBorrowingsCommand}"/>
                    <Button Classes="navBtn" Content="Student History" Command="{Binding ShowStudentHistoryCommand}"/>
                    <Button Classes="navBtn" Content="Equipment History" Command="{Binding ShowEquipmentHistoryCommand}"/>

                    <!-- Category: Student Management -->
                    <TextBlock Classes="sidebarCategory" Text="STUDENT MANAGEMENT"/>
                    <Button Classes="navBtn" Content="Register Student" Command="{Binding ShowRegisterStudentCommand}"/>
                    <Button Classes="navBtn" Content="Update Student Info" Command="{Binding ShowUpdateStudentInformationCommand}"/>
                    <Button Classes="navBtn" Content="Change Eligibility" Command="{Binding ShowChangeStudentEligibilityCommand}"/>

                    <!-- Category: Equipment Management -->
                    <TextBlock Classes="sidebarCategory" Text="EQUIPMENT MANAGEMENT"/>
                    <Button Classes="navBtn" Content="Register Equipment" Command="{Binding ShowRegisterEquipmentCommand}"/>
                    <Button Classes="navBtn" Content="Update Equipment Info" Command="{Binding ShowUpdateEquipmentCommand}"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1"
                Background="#FFFFFF"
                Padding="24">

            <ContentControl Content="{Binding CurrentView}"/>

        </Border>

    </Grid>

</Window>