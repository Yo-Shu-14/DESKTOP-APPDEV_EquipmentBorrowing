<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    x:Class="EquipmentBorrowing.Desktop.Views.UpdateEquipmentInformationView"
    x:DataType="viewmodels:UpdateEquipmentInformationViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16">

            <!-- Title -->
            <StackPanel>
                <TextBlock Classes="title" Text="Update Equipment Information"/>
                <TextBlock Classes="subheading" Text="Edit identifier, name, or description. Availability and borrowing history remain preserved."/>
            </StackPanel>

            <Border Classes="formContainer">
                <StackPanel Spacing="12">

                    <TextBlock Classes="formLabel" Text="Select Equipment"/>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding EquipmentList}"
                        SelectedItem="{Binding SelectedEquipment}"
                        PlaceholderText="Select equipment to edit">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding EquipmentIdentifier}" FontWeight="Bold"/>
                                    <TextBlock Text="-" Foreground="#6c757d"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Classes="formLabel" Text="Equipment Identifier *"/>
                    <TextBox
                        Text="{Binding EquipmentIdentifier}"
                        PlaceholderText="Equipment identifier"/>

                    <TextBlock Classes="formLabel" Text="Equipment Name *"/>
                    <TextBox
                        Text="{Binding EquipmentName}"
                        PlaceholderText="Equipment name"/>

                    <TextBlock Classes="formLabel" Text="Description (Optional)"/>
                    <TextBox
                        Text="{Binding Description}"
                        PlaceholderText="Clear field to remove description"
                        AcceptsReturn="True"
                        Height="90"
                        TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button
                            Content="Save Changes"
                            Command="{Binding UpdateEquipmentCommand}"
                            IsEnabled="{Binding !IsLoading}"/>

                        <Button
                            Content="Refresh List"
                            Command="{Binding LoadEquipmentCommand}"/>
                    </StackPanel>

                    <TextBlock
                        Classes="feedback"
                        Text="{Binding FeedbackMessage}"
                        IsVisible="{Binding FeedbackMessage.Length}"/>

                    <TextBlock
                        Text="Loading equipment data..."
                        IsVisible="{Binding IsLoading}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>