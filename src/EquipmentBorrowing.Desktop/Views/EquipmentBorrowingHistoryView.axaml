<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:api="using:EquipmentBorrowing.Desktop.ApiClient"
    x:Class="EquipmentBorrowing.Desktop.Views.EquipmentBorrowingHistoryView"
    x:DataType="viewmodels:EquipmentBorrowingHistoryViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Classes="title" Text="Equipment Borrowing History"/>
            <TextBlock Classes="subheading" Text="View borrowing history and past borrowers for a selected equipment item."/>
        </StackPanel>

        <!-- Selection Panel -->
        <Border Grid.Row="1" Classes="panelCard">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="formLabel" Text="Select Equipment" Margin="0,0,0,4"/>
                    <ComboBox
                        ItemsSource="{Binding EquipmentList}"
                        SelectedItem="{Binding SelectedEquipment}"
                        MinWidth="280">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="api:EquipmentDto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding EquipmentCode}" FontWeight="Bold"/>
                                    <TextBlock Text="-" Foreground="#6c757d"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Button
                    Content="View History"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    Command="{Binding LoadHistoryCommand}"/>

                <TextBlock
                    Text="{Binding BorrowingHistory.Count, StringFormat='Total Records: {0}'}"
                    FontWeight="Bold"
                    VerticalAlignment="Bottom"
                    Margin="16,0,0,12"/>
            </StackPanel>
        </Border>

        <!-- Feedback & Status -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock
                Classes="feedback"
                Text="{Binding FeedbackMessage}"
                IsVisible="{Binding FeedbackMessage.Length}"/>

            <TextBlock
                Text="Loading equipment history..."
                IsVisible="{Binding IsLoading}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsError}">
                <TextBlock Text="Failed to load equipment history." VerticalAlignment="Center"/>
                <Button Content="Retry" Command="{Binding LoadHistoryCommand}"/>
            </StackPanel>

            <TextBlock
                Text="No borrowing history found for this equipment."
                IsVisible="{Binding IsEmpty}"
                Margin="0,10"/>
        </StackPanel>

        <!-- Records List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding BorrowingHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="api:BorrowingDto">
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#E2E3E5" CornerRadius="4" Padding="6,2">
                                            <TextBlock
                                                Text="{Binding Status}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#383D41"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock
                                        Text="{Binding StudentName, StringFormat='Borrower: {0}'}"
                                        FontSize="17"
                                        FontWeight="Bold"/>

                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                        <TextBlock
                                            Text="{Binding BorrowedDate, StringFormat='Borrowed: {0}'}"
                                            FontSize="12"
                                            Foreground="#6c757d"/>
                                        <TextBlock
                                            Text="{Binding ExpectedReturnDate, StringFormat='Expected Return: {0}'}"
                                            FontSize="12"
                                            Foreground="#6c757d"/>
                                        <TextBlock
                                            Text="{Binding ReturnedDate, StringFormat='Actual Return: {0}'}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#0F5132"
                                            IsVisible="{Binding ReturnedDate, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
