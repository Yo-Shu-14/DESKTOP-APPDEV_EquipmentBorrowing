<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:api="using:EquipmentBorrowing.Desktop.ApiClient"
    x:Class="EquipmentBorrowing.Desktop.Views.ActiveBorrowingsView"
    x:DataType="viewmodels:ActiveBorrowingsViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Classes="title" Text="Active Borrowings"/>
            <TextBlock Classes="subheading" Text="View equipment currently checked out and record returns."/>
        </StackPanel>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Classes="panelCard">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="Refresh List" Command="{Binding LoadBorrowingsCommand}"/>
                    <TextBlock
                        Text="{Binding ActiveBorrowings.Count, StringFormat='Active loans: {0}'}"
                        FontWeight="Bold"
                        VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Feedback Messages -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock
                Classes="feedback"
                FontWeight="SemiBold"
                Text="{Binding FeedbackMessage}"
                IsVisible="{Binding FeedbackMessage.Length}"/>

            <TextBlock
                Text="Loading active borrowings..."
                IsVisible="{Binding IsLoading}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsError}">
                <TextBlock Text="Failed to load borrowings." VerticalAlignment="Center"/>
                <Button Content="Retry" Command="{Binding LoadBorrowingsCommand}"/>
            </StackPanel>

            <TextBlock
                Text="No active borrowings found. All equipment items are returned."
                IsVisible="{Binding IsEmpty}"
                Margin="0,10"/>
        </StackPanel>

        <!-- Borrowings List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ActiveBorrowings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="api:BorrowingDto">
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">

                                <!-- Details -->
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#E9ECEF" CornerRadius="4" Padding="6,2">
                                            <TextBlock
                                                Text="{Binding EquipmentCode}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#495057"/>
                                        </Border>
                                        <Border Background="#D1E7DD" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="Active" FontSize="11" FontWeight="Bold" Foreground="#0F5132"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock
                                        Text="{Binding EquipmentName}"
                                        FontSize="17"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Text="{Binding StudentName, StringFormat='Borrower: {0}'}"
                                        FontWeight="SemiBold"
                                        FontSize="13"/>

                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                        <TextBlock
                                            Text="{Binding BorrowedDate, StringFormat='Borrowed: {0}'}"
                                            FontSize="12"
                                            Foreground="#6c757d"/>
                                        <TextBlock
                                            Text="{Binding ExpectedReturnDate, StringFormat='Due: {0}'}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#B02A37"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Return Action -->
                                <Button
                                    Grid.Column="1"
                                    Content="Record Return"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0"
                                    Command="{Binding $parent[UserControl].DataContext.ReturnCommand}"
                                    CommandParameter="{Binding}"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>

</UserControl>
