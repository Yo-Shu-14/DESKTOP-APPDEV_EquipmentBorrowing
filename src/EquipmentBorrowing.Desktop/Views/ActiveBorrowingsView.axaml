<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    x:Class="EquipmentBorrowing.Desktop.Views.ActiveBorrowingsView"
    x:DataType="viewmodels:ActiveBorrowingsViewModel">

    <StackPanel Margin="30" Spacing="20">

        <TextBlock
            Text="Active Borrowings"
            FontSize="28"
            FontWeight="Bold"/>

        <TextBlock
            Text="Equipment currently borrowed"
            FontSize="16"/>

        <Button
            Content="Refresh"
            Command="{Binding LoadBorrowingsCommand}"
            HorizontalAlignment="Left"/>

        <ItemsControl ItemsSource="{Binding ActiveBorrowings}">

            <ItemsControl.ItemTemplate>

                <DataTemplate x:DataType="domain:Borrowing">

                    <Border
                        BorderBrush="Gray"
                        BorderThickness="1"
                        Padding="15"
                        Margin="0,5">

                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="{Binding BorrowingId}"
                                FontSize="12"/>

                            <TextBlock
                                Text="{Binding Equipment.Name}"
                                FontSize="18"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="{Binding Equipment.Description}"/>

                            <TextBlock
                                Text="{Binding DateBorrowed, StringFormat='Borrowed: {0:MMM dd, yyyy}'}"/>

                            <TextBlock
                                Text="{Binding ExpectedReturnDate, StringFormat='Expected Return: {0:MMM dd, yyyy}'}"/>

                            <TextBlock
                                Text="{Binding Status}"/>

                            <Button
                                Content="Return"
                                Command="{Binding $parent[UserControl].DataContext.ReturnCommand}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </StackPanel>

</UserControl>