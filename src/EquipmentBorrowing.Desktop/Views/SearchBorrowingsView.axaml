<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    x:Class="EquipmentBorrowing.Desktop.Views.SearchBorrowingsView"
    x:DataType="viewmodels:SearchBorrowingsViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Classes="title" Text="Search &amp; Filter Borrowings"/>
            <TextBlock Classes="subheading" Text="Search by student name, student number, or equipment name; filter by status; and sort."/>
        </StackPanel>

        <!-- Search & Filter Controls -->
        <Border Grid.Row="1" Classes="panelCard">
            <StackPanel Spacing="10">
                <!-- Search text box -->
                <TextBox
                    PlaceholderText="Search student name, student number, or equipment name..."
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Filter Controls Row -->
                <Grid ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="formLabel" Text="Status" Margin="0,0,0,2"/>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding StatusOptions}"
                            SelectedItem="{Binding SelectedStatus}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="formLabel" Text="Sort By" Margin="0,0,0,2"/>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding SortFieldOptions}"
                            SelectedItem="{Binding SelectedSortField}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="formLabel" Text="Direction" Margin="0,0,0,2"/>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding SortDirectionOptions}"
                            SelectedItem="{Binding SelectedSortDirection}"/>
                    </StackPanel>

                    <Button
                        Grid.Column="3"
                        Content="Reset Filters"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,2"
                        Command="{Binding ResetFiltersCommand}"/>

                    <Button
                        Grid.Column="4"
                        Content="Refresh"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,2"
                        Command="{Binding LoadBorrowingsCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Feedback & Status -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock
                Text="{Binding Borrowings.Count, StringFormat='Total Records: {0}'}"
                FontWeight="Bold"
                Margin="0,0,0,4"/>

            <TextBlock
                Classes="feedback"
                Text="{Binding FeedbackMessage}"
                IsVisible="{Binding FeedbackMessage.Length}"/>

            <TextBlock
                Text="Loading borrowing records..."
                IsVisible="{Binding IsLoading}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsError}">
                <TextBlock Text="Failed to load borrowing records." VerticalAlignment="Center"/>
                <Button Content="Retry" Command="{Binding LoadBorrowingsCommand}"/>
            </StackPanel>

            <TextBlock
                Text="No matching borrowing records found."
                IsVisible="{Binding IsEmpty}"
                Margin="0,10"/>
        </StackPanel>

        <!-- Results List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Borrowings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="domain:Borrowing">
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#E9ECEF" CornerRadius="4" Padding="6,2">
                                            <TextBlock
                                                Text="{Binding Equipment.EquipmentIdentifier}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#495057"/>
                                        </Border>
                                        <Border Background="#E2E3E5" CornerRadius="4" Padding="6,2">
                                            <TextBlock
                                                Text="{Binding Status}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#383D41"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock
                                        Text="{Binding Equipment.Name}"
                                        FontSize="17"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Text="{Binding Student.Name, StringFormat='Borrower: {0}'}"
                                        FontWeight="SemiBold"
                                        FontSize="13"/>

                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                        <TextBlock
                                            Text="{Binding DateBorrowed, StringFormat='Borrowed: {0:MMM dd, yyyy}'}"
                                            FontSize="12"
                                            Foreground="#6c757d"/>
                                        <TextBlock
                                            Text="{Binding ExpectedReturnDate, StringFormat='Expected Return: {0:MMM dd, yyyy}'}"
                                            FontSize="12"
                                            Foreground="#6c757d"/>
                                        <TextBlock
                                            Text="{Binding ActualReturnDate, StringFormat='Actual Return: {0:MMM dd, yyyy}'}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#0F5132"
                                            IsVisible="{Binding ActualReturnDate, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>