<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:api="using:EquipmentBorrowing.Desktop.ApiClient"
    x:Class="EquipmentBorrowing.Desktop.Views.SearchBorrowingsView"
    x:DataType="viewmodels:SearchBorrowingsViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Classes="title" Text="Search and Filter Borrowings"/>
            <TextBlock Classes="subheading" Text="Query, filter, and sort active or historical loan records across all students and equipment."/>
        </StackPanel>

        <!-- Search & Filter Controls -->
        <Border Grid.Row="1" Classes="panelCard">
            <StackPanel Spacing="12">
                <!-- Search Input -->
                <TextBox
                    Text="{Binding SearchText, Mode=TwoWay}"
                    PlaceholderText="Search by student name, institutional number, equipment name, or equipment identifier..."/>

                <!-- Dropdowns & Actions Row -->
                <Grid ColumnDefinitions="*,*,*,Auto,Auto">
                    <!-- Status Filter -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Classes="formLabel" Text="Status" Margin="0,0,0,4"/>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding StatusOptions}"
                            SelectedItem="{Binding SelectedStatus}"/>
                    </StackPanel>

                    <!-- Sort Field -->
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Classes="formLabel" Text="Sort By" Margin="0,0,0,4"/>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding SortFieldOptions}"
                            SelectedItem="{Binding SelectedSortField}"/>
                    </StackPanel>

                    <!-- Sort Direction -->
                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                        <TextBlock Classes="formLabel" Text="Direction" Margin="0,0,0,4"/>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding SortDirectionOptions}"
                            SelectedItem="{Binding SelectedSortDirection}"/>
                    </StackPanel>

                    <!-- Reset Button -->
                    <Button
                        Grid.Column="3"
                        Content="Reset Filters"
                        VerticalAlignment="Bottom"
                        Margin="8,0,8,2"
                        Command="{Binding ResetFiltersCommand}"/>

                    <!-- Refresh Button -->
                    <Button
                        Grid.Column="4"
                        Content="Refresh"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,2"
                        Command="{Binding LoadBorrowingsCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Feedback & Status -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock
                Text="{Binding Borrowings.Count, StringFormat='Total Records: {0}'}"
                FontWeight="Bold"
                Margin="0,0,0,4"/>

            <TextBlock
                Classes="feedback"
                Text="{Binding FeedbackMessage}"
                IsVisible="{Binding FeedbackMessage.Length}"/>

            <TextBlock
                Text="Loading borrowing records..."
                IsVisible="{Binding IsLoading}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsError}">
                <TextBlock Text="Failed to load borrowing records." VerticalAlignment="Center"/>
                <Button Content="Retry" Command="{Binding LoadBorrowingsCommand}"/>
            </StackPanel>

            <TextBlock
                Text="No matching borrowing records found."
                IsVisible="{Binding IsEmpty}"
                Margin="0,10"/>
        </StackPanel>

        <!-- Results List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Borrowings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="api:BorrowingDto">
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#E9ECEF" CornerRadius="4" Padding="6,2">
                                            <TextBlock
                                                Text="{Binding EquipmentCode}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#495057"/>
                                        </Border>
                                        <Border Background="#E2E3E5" CornerRadius="4" Padding="6,2">
                                            <TextBlock
                                                Text="{Binding Status}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#383D41"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock
                                        Text="{Binding EquipmentName}"
                                        FontSize="17"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Text="{Binding StudentName, StringFormat='Borrower: {0}'}"
                                        FontWeight="SemiBold"
                                        FontSize="13"/>

                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                        <TextBlock
                                            Text="{Binding BorrowedDate, StringFormat='Borrowed: {0}'}"
                                            FontSize="12"
                                            Foreground="#6c757d"/>
                                        <TextBlock
                                            Text="{Binding ExpectedReturnDate, StringFormat='Expected Return: {0}'}"
                                            FontSize="12"
                                            Foreground="#6c757d"/>
                                        <TextBlock
                                            Text="{Binding ReturnedDate, StringFormat='Actual Return: {0}'}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#0F5132"
                                            IsVisible="{Binding ReturnedDate, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
