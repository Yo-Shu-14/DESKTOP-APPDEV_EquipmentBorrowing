<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    x:Class="EquipmentBorrowing.Desktop.Views.RegisterStudentView"
    x:DataType="viewmodels:RegisterStudentViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16">

            <!-- Title -->
            <StackPanel>
                <TextBlock Classes="title" Text="Register Student"/>
                <TextBlock Classes="subheading" Text="Add a new student record to the system with borrowing eligibility enabled by default."/>
            </StackPanel>

            <Border Classes="formContainer">
                <StackPanel Spacing="12">

                    <TextBlock Classes="formLabel" Text="Institutional Number *"/>
                    <TextBox
                        Text="{Binding InstitutionalNumber}"
                        PlaceholderText="e.g. 2024-0010"/>

                    <TextBlock Classes="formLabel" Text="Full Name *"/>
                    <TextBox
                        Text="{Binding StudentName}"
                        PlaceholderText="e.g. Juan Dela Cruz"/>

                    <TextBlock Classes="formLabel" Text="Contact Information (Optional)"/>
                    <TextBox
                        Text="{Binding ContactInformation}"
                        PlaceholderText="e.g. 0912-345-6789 or email@campus.edu"/>

                    <Button
                        Content="Register Student"
                        Command="{Binding RegisterStudentCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"/>

                    <TextBlock
                        Classes="feedback"
                        Text="{Binding FeedbackMessage}"
                        IsVisible="{Binding FeedbackMessage.Length}"/>

                    <TextBlock
                        Text="Registering student..."
                        IsVisible="{Binding IsLoading}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>