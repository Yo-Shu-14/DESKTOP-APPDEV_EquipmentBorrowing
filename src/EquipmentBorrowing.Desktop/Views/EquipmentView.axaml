<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:api="using:EquipmentBorrowing.Desktop.ApiClient"
    x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
    x:DataType="viewmodels:EquipmentViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Title & Subheading -->
        <StackPanel Grid.Row="0">
            <TextBlock Classes="title" Text="Equipment Catalog"/>
            <TextBlock Classes="subheading" Text="View equipment availability and issue single or multi-item borrowings."/>
        </StackPanel>

        <!-- Borrowing & Multi-item Checkout Panel -->
        <Border Grid.Row="1" Classes="panelCard">
            <Grid ColumnDefinitions="*,*">

                <!-- Left: Student & Expected Return Date -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="4">
                    <TextBlock Classes="formLabel" Text="Borrowing Student"/>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding StudentList}"
                        SelectedItem="{Binding SelectedStudent}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="api:StudentDto">
                                <TextBlock Text="{Binding FullName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Classes="formLabel" Text="Expected Return Date"/>
                    <DatePicker
                        HorizontalAlignment="Stretch"
                        SelectedDate="{Binding ExpectedReturnDate}"/>

                    <!-- Catalog Filter Controls -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button
                            Content="Show All"
                            Command="{Binding LoadEquipmentCommand}"/>
                        <Button
                            Content="Available Only"
                            Command="{Binding LoadAvailableEquipmentCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Multi-Item Checkout Basket -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                    <TextBlock Classes="formLabel"
                               Text="{Binding SelectedEquipmentList.Count, StringFormat='Multi-Item Checkout Basket ({0} items)'}"/>

                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" MinHeight="75" MaxHeight="110" Padding="6" Background="#FFFFFF">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    Text="No items added yet. Click 'Add to Checkout' on available items."
                                    FontSize="12"
                                    Foreground="#888888"
                                    Margin="4"
                                    IsVisible="{Binding !SelectedEquipmentList.Count}"/>

                                <ItemsControl ItemsSource="{Binding SelectedEquipmentList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="api:EquipmentDto">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{Binding Name}"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"/>
                                                <Button
                                                    Grid.Column="1"
                                                    Content="âœ•"
                                                    Padding="6,2"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding $parent[UserControl].DataContext.RemoveFromCheckoutCommand}"
                                                    CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Button
                        Content="Submit Multi-Item Checkout"
                        Command="{Binding CheckoutCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Feedback & Status Notifications -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock
                Classes="feedback"
                FontWeight="SemiBold"
                Text="{Binding FeedbackMessage}"
                IsVisible="{Binding FeedbackMessage.Length}"/>

            <TextBlock
                Text="Loading equipment catalog..."
                IsVisible="{Binding IsLoading}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsError}">
                <TextBlock Text="Failed to connect to API server." VerticalAlignment="Center"/>
                <Button Content="Retry Loading" Command="{Binding LoadEquipmentCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEmpty}">
                <TextBlock Text="No equipment registered yet." VerticalAlignment="Center"/>
                <Button Content="Refresh" Command="{Binding LoadEquipmentCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- Equipment Cards List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding EquipmentList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="api:EquipmentDto">
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">

                                <!-- Details -->
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Background="#E9ECEF" CornerRadius="4" Padding="6,2">
                                            <TextBlock
                                                Text="{Binding EquipmentCode}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#495057"/>
                                        </Border>

                                        <TextBlock
                                            Text="{Binding IsAvailable, StringFormat='Available: {0}'}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontSize="17"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Text="{Binding Description}"
                                        FontSize="13"
                                        Foreground="#6c757d"
                                        TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button
                                        Content="Borrow Single"
                                        IsEnabled="{Binding IsAvailable}"
                                        Command="{Binding $parent[UserControl].DataContext.BorrowCommand}"
                                        CommandParameter="{Binding}"/>

                                    <Button
                                        Content="+ Add to Checkout"
                                        IsEnabled="{Binding IsAvailable}"
                                        Command="{Binding $parent[UserControl].DataContext.AddToCheckoutCommand}"
                                        CommandParameter="{Binding}"/>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
