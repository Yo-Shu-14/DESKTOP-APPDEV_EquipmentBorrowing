<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
    x:DataType="viewmodels:EquipmentViewModel">

    <Grid
        Margin="30"
        RowDefinitions="Auto,Auto,Auto,*">

        <TextBlock
            Grid.Row="0"
            Text="Equipment"
            FontSize="28"
            FontWeight="Bold"/>

        <TextBlock
            Grid.Row="1"
            Text="Available equipment"
            FontSize="16"
            Margin="0,5,0,0"/>

        <StackPanel
            Grid.Row="2"
            Spacing="5"
            Margin="0,10,0,10">

            <TextBlock Text="Expected Return Date"/>

            <DatePicker
                SelectedDate="{Binding ExpectedReturnDate}"/>

            <TextBlock
                Text="{Binding FeedbackMessage}"
                FontSize="14"
                Margin="0,5"/>

        </StackPanel>

        <!-- This row takes the remaining space -->
        <ScrollViewer
            Grid.Row="3"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl ItemsSource="{Binding EquipmentList}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate x:DataType="domain:Equipment">

                        <Border
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Padding="15"
                            Margin="0,5">

                            <StackPanel>

                                <TextBlock
                                    Text="{Binding EquipmentId}"
                                    FontSize="12"/>

                                <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="18"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Text="{Binding Description}"/>

                                <TextBlock
                                    Text="{Binding IsAvailable}"/>

                                <Button
                                    Content="Borrow"
                                    Command="{Binding $parent[UserControl].DataContext.BorrowCommand}"
                                    CommandParameter="{Binding}"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>