
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
    x:DataType="viewmodels:EquipmentViewModel">

    <Grid Margin="30"
          RowDefinitions="Auto,Auto,Auto,*">

        <TextBlock
            Grid.Row="0"
            Classes="title"
            Text="Equipment Catalog"/>

        
        <TextBlock
            Grid.Row="1"
            Classes="subheading"
            Text="All registered equipment"/>

        <StackPanel
            Grid.Row="2"
            Spacing="5"
            Margin="0,10,0,10">

            <TextBlock Classes="formLabel"
                       Text="Borrowing Student"/>

            <ComboBox
                ItemsSource="{Binding StudentList}"
                SelectedItem="{Binding SelectedStudent}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Student">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Classes="formLabel"
                       Text="Expected Return Date"/>

            <DatePicker
                SelectedDate="{Binding ExpectedReturnDate}"/>

            <TextBlock
                Classes="feedback"
                Text="{Binding FeedbackMessage}"/>
            <TextBlock
                Text="{Binding SelectedEquipmentList.Count,
                    StringFormat='Selected items: {0}'}"
                FontWeight="Bold"/>

            <ItemsControl ItemsSource="{Binding SelectedEquipmentList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="domain:Equipment">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10">

                            <TextBlock
                                Text="{Binding Name}"
                                VerticalAlignment="Center"/>

                            <Button
                                Content="Remove"
                                Command="{Binding $parent[UserControl].DataContext.RemoveFromCheckoutCommand}"
                                CommandParameter="{Binding}"/>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="3"
              RowDefinitions="Auto,*">

            <StackPanel Grid.Row="0"
                        Spacing="5">

                <TextBlock
                    Text="Loading equipment..."
                    IsVisible="{Binding IsLoading}"/>

                <TextBlock
                    Text="No equipment registered yet."
                    IsVisible="{Binding IsEmpty}"/>

                <Button
                    Content="Retry Loading"
                    Command="{Binding LoadEquipmentCommand}"
                    IsVisible="{Binding IsEmpty}"/>

                <Button
                    Content="Retry Loading"
                    Command="{Binding LoadEquipmentCommand}"
                    IsVisible="{Binding IsError}"/>

                <Button
                    Content="Checkout Selected Items"
                    Command="{Binding CheckoutCommand}"
                    HorizontalAlignment="Left"/>  
             
                <Button 
                    Content="Show Available Equipment"
                    Command="{Binding LoadAvailableEquipmentCommand}"/> 
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding EquipmentList}">

            
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="domain:Equipment">

                            <Border Classes="card">
                                <StackPanel>

                                    <TextBlock
                                        Text="{Binding EquipmentId}"
                                        FontSize="12"/>

                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontSize="18"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Text="{Binding Description}"/>

                                    <TextBlock
                                        Text="{Binding IsAvailable,
                                            StringFormat='Available: {0}'}"/>

                                    <Button
                                        Content="Borrow"
                                        Command="{Binding $parent[UserControl].DataContext.BorrowCommand}"
                                        CommandParameter="{Binding}"/>
                                    <Button
                                        Content="Add to Checkout"
                                        Command="{Binding $parent[UserControl].DataContext.AddToCheckoutCommand}"
                                        CommandParameter="{Binding}"/>

                                </StackPanel>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                      
                </ItemsControl>
                
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
