<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:api="using:EquipmentBorrowing.Desktop.ApiClient"
    x:Class="EquipmentBorrowing.Desktop.Views.UpdateStudentInformationView"
    x:DataType="viewmodels:UpdateStudentInformationViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16">

            <!-- Title -->
            <StackPanel>
                <TextBlock Classes="title" Text="Update Student Information"/>
                <TextBlock Classes="subheading" Text="Edit descriptive details for a selected student. Internal identity and borrowing history are preserved."/>
            </StackPanel>

            <Border Classes="formContainer">
                <StackPanel Spacing="12">

                    <TextBlock Classes="formLabel" Text="Select Student"/>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Students}"
                        SelectedItem="{Binding SelectedStudent}"
                        PlaceholderText="Select student to edit">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="api:StudentDto">
                                <TextBlock Text="{Binding FullName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Classes="formLabel" Text="Institutional Number *"/>
                    <TextBox
                        Text="{Binding InstitutionalNumber}"
                        PlaceholderText="Institutional student number"/>

                    <TextBlock Classes="formLabel" Text="Full Name *"/>
                    <TextBox
                        Text="{Binding StudentName}"
                        PlaceholderText="Full name"/>

                    <TextBlock Classes="formLabel" Text="Contact Information (Optional)"/>
                    <TextBox
                        Text="{Binding ContactInformation}"
                        PlaceholderText="Clear field to remove contact information"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button
                            Content="Save Changes"
                            Command="{Binding UpdateStudentCommand}"
                            IsEnabled="{Binding !IsLoading}"/>

                        <Button
                            Content="Refresh List"
                            Command="{Binding LoadStudentsCommand}"/>
                    </StackPanel>

                    <TextBlock
                        Classes="feedback"
                        Text="{Binding FeedbackMessage}"
                        IsVisible="{Binding FeedbackMessage.Length}"/>

                    <TextBlock
                        Text="Loading student data..."
                        IsVisible="{Binding IsLoading}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
