<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    x:Class="EquipmentBorrowing.Desktop.Views.RegisterEquipmentView"
    x:DataType="viewmodels:RegisterEquipmentViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16">

            <!-- Title -->
            <StackPanel>
                <TextBlock Classes="title" Text="Register Equipment"/>
                <TextBlock Classes="subheading" Text="Register a new equipment item into the catalog with initial Available status."/>
            </StackPanel>

            <Border Classes="formContainer">
                <StackPanel Spacing="12">

                    <TextBlock Classes="formLabel" Text="Equipment Identifier *"/>
                    <TextBox
                        Text="{Binding EquipmentIdentifier}"
                        PlaceholderText="e.g. EQ-010 or LAPTOP-05"/>

                    <TextBlock Classes="formLabel" Text="Equipment Name *"/>
                    <TextBox
                        Text="{Binding EquipmentName}"
                        PlaceholderText="e.g. Dell Latitude 5420"/>

                    <TextBlock Classes="formLabel" Text="Description (Optional)"/>
                    <TextBox
                        Text="{Binding Description}"
                        PlaceholderText="Brief description of the item"
                        AcceptsReturn="True"
                        Height="90"
                        TextWrapping="Wrap"/>

                    <Button
                        Content="Register Equipment"
                        Command="{Binding RegisterEquipmentCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"/>

                    <TextBlock
                        Classes="feedback"
                        Text="{Binding FeedbackMessage}"
                        IsVisible="{Binding FeedbackMessage.Length}"/>

                    <TextBlock
                        Text="Registering equipment..."
                        IsVisible="{Binding IsLoading}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>