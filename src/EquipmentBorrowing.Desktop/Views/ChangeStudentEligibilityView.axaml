<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    x:Class="EquipmentBorrowing.Desktop.Views.ChangeStudentEligibilityView"
    x:DataType="viewmodels:ChangeStudentEligibilityViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16">

            <!-- Title -->
            <StackPanel>
                <TextBlock Classes="title" Text="Change Student Borrowing Eligibility"/>
                <TextBlock Classes="subheading" Text="Permit or restrict a student from borrowing equipment. Existing loans and history remain unaffected."/>
            </StackPanel>

            <Border Classes="formContainer">
                <StackPanel Spacing="12">

                    <TextBlock Classes="formLabel" Text="Select Student"/>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Students}"
                        SelectedItem="{Binding SelectedStudent}"
                        PlaceholderText="Select student to change eligibility">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Background="#E9ECEF" CornerRadius="6" Padding="12" Margin="0,4">
                        <TextBlock
                            Text="{Binding SelectedStudent.IsAllowedToBorrow, StringFormat='Current Status: Allowed to Borrow = {0}'}"
                            FontWeight="SemiBold"
                            FontSize="13"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button
                            Content="Permit Borrowing"
                            Command="{Binding PermitStudentCommand}"/>

                        <Button
                            Content="Restrict Borrowing"
                            Command="{Binding RestrictStudentCommand}"/>

                        <Button
                            Content="Refresh List"
                            Command="{Binding LoadStudentsCommand}"/>
                    </StackPanel>

                    <TextBlock
                        Classes="feedback"
                        Text="{Binding FeedbackMessage}"
                        IsVisible="{Binding FeedbackMessage.Length}"/>

                    <TextBlock
                        Text="Loading students..."
                        IsVisible="{Binding IsLoading}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>