<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    x:Class="EquipmentBorrowing.Desktop.Views.StudentBorrowingHistoryView"
    x:DataType="viewmodels:StudentBorrowingHistoryViewModel">

    <Grid Margin="30" RowDefinitions="Auto,Auto,Auto,*">

        <TextBlock
            Text="Student Borrowing History"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Spacing="10">

            <TextBlock Text="Select Student" FontWeight="Bold"/>

            <ComboBox
                ItemsSource="{Binding StudentList}"
                SelectedItem="{Binding SelectedStudent}"
                Width="300"
                HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Student">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button
                Content="View History"
                Command="{Binding LoadHistoryCommand}"
                HorizontalAlignment="Left"/>

            <TextBlock
                Text="{Binding FeedbackMessage}"
                TextWrapping="Wrap"/>

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <TextBlock
                Text="{Binding BorrowingHistory.Count,
                    StringFormat='Total Records: {0}'}"
                FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Row="3">

            <TextBlock
                Text="Loading borrowing history..."
                IsVisible="{Binding IsLoading}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <Button
                Content="Retry"
                Command="{Binding LoadHistoryCommand}"
                IsVisible="{Binding IsError}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <TextBlock
                Text="No borrowing history available."
                IsVisible="{Binding IsEmpty}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding BorrowingHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="domain:Borrowing">
                            <Border
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,5">

                                <StackPanel Spacing="6">

                                    <TextBlock
                                        Text="{Binding Equipment.Name}"
                                        FontSize="18"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Text="{Binding Equipment.Description}"/>

                                    <TextBlock
                                        Text="{Binding DateBorrowed,
                                            StringFormat='Date Borrowed: {0:MMM dd, yyyy}'}"/>

                                    <TextBlock
                                        Text="{Binding ExpectedReturnDate,
                                            StringFormat='Expected Return: {0:MMM dd, yyyy}'}"/>

                                    <TextBlock
                                        Text="{Binding ActualReturnDate,
                                            StringFormat='Actual Return: {0:MMM dd, yyyy}'}"/>

                                    <TextBlock
                                        Text="{Binding Status,
                                            StringFormat='Status: {0}'}"
                                        FontWeight="Bold"/>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>